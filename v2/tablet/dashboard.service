[Unit]
Description=Fetch the v2 reMarkable sleep screen
After=network.target
ConditionPathExists=/home/root/rpp-sleep-screen-v2/config.env

[Service]
Type=oneshot
Environment="PATH=/home/root/.vellum/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/root/rpp-sleep-screen-v2/config.env
ExecStart=/bin/sh /home/root/rpp-sleep-screen-v2/update.sh